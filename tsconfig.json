{
	"compilerOptions": {
		"strict": true,
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"outDir": "dist",
		"rootDir": ".",
		"jsx": "react-jsx",
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["src", "test", "scripts", "shared"],
	"exclude": ["test/web"]
}
